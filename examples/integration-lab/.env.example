# These settings belong to this app's backend, not the AO root .env.
# The server and browser addresses differ because AO is inside Docker.
AO_ORIGIN=http://127.0.0.1:4000
AO_WIDGET_ORIGIN=http://localhost:4000
AO_APPLICATION_ORIGIN=http://localhost:3003
AO_SESSION_ENDPOINT=/api/ao/session
AO_TENANT_ID=integration-lab
AO_DEPLOYMENT_ID=
AO_INTEGRATION_KEY=
AO_ALLOW_LOCALHOST=true
