{
  "openapi": "3.0.3",
  "info": {
    "title": "Taskroom API",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3003/api"
    }
  ],
  "paths": {
    "/tasks": {
      "get": {
        "operationId": "list_tasks",
        "summary": "List the signed-in user’s tasks",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "operationId": "create_task",
        "summary": "Create a task for the signed-in user",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                },
                "required": [
                  "title"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/tasks/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "patch": {
        "operationId": "update_task",
        "summary": "Set the completion status of one of the user’s tasks",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "done": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "done"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "delete_task",
        "summary": "Delete one of the signed-in user’s tasks",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  }
}
