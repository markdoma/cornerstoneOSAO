DATABASE_URL=postgresql://orchestrator:orchestrator@localhost:5432/orchestrator
API_PORT=4000
API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
WIDGET_ORIGIN=http://localhost:4000
SAMPLE_ORIGIN=http://localhost:3002
OPENAI_API_KEY=
OPENAI_MODELS=gpt-4.1-mini
# Generate with: openssl rand -hex 32
CREDENTIAL_KEY=
SMTP_URL=smtp://localhost:1025
MAIL_FROM=CornerstoneLabs AO <no-reply@localhost>
# Optional native Taskboard demo for npm run dev. Docker uses docker-compose.demo.yml.
ENABLE_DEMO_APP=false
# Leave blank to use the default Taskboard API allowlist when the native demo is on.
ALLOW_LOCAL_DEMO_API=
SAMPLE_INTEGRATION_KEY=
SAMPLE_DEPLOYMENT_ID=
# Must match the tenant ID configured in the sample MCP bridge.
SAMPLE_TENANT_ID=
# Match the host session endpoint configured in MCP Bridge Authentication.
SAMPLE_SESSION_ENDPOINT=/assistant/session
# Optional restriction; leave blank to use published, enabled tools.
SAMPLE_TOOL_IDS=

# Retired direct setup APIs; leave false for MCP-only setup.
LEGACY_DIRECT_SETUP_ENABLED=false

# Managed MCP bridge (opt-in; run npm run setup:bridge for local development).
MCP_BRIDGE_ENABLED=false
BRIDGE_URL=http://127.0.0.1:4010
BRIDGE_PORT=4010
BRIDGE_HOST=127.0.0.1
BRIDGE_ALLOWED_HOSTS=localhost,127.0.0.1,bridge
# AO holds the private signing key; the bridge receives the public key only.
BRIDGE_PRIVATE_KEY_PATH=
BRIDGE_PUBLIC_KEY_PATH=
BRIDGE_SIGNING_KID=ao-bridge-1
BRIDGE_DATABASE_URL=
BRIDGE_REDIS_URL=redis://127.0.0.1:56379
# Dedicated AES-256 key; not the legacy AO credential key.
BRIDGE_ENCRYPTION_KEY=

# Optional historical JWT compatibility mode (not needed for MCP Bridges).
# Historical first-party HRIS mode; new integrations use MCP Bridges above.
# Existing deployment auth modes stay pinned; this does not migrate them.
# Set a distinct AO organization for each HRIS tenant (JSON object).
# FIRST_PARTY_JWKS_URL=https://hris.example.com/.well-known/jwks.json
FIRST_PARTY_TENANT_ORGS={}
# HRIS_INTERNAL_API_BASE_URL=https://hris.example.com/internal/v1
# AO_SERVICE_TOKEN=server-only-random-secret-at-least-32-characters
# Issuer settings apply to the sample host; AO must never receive the private key.
# HRIS_SIGNING_PRIVATE_KEY_PATH=/secure/hris-private.pem
# HRIS_SIGNING_PUBLIC_KEY_PATH=/secure/hris-public.pem
# HRIS_SIGNING_ALGORITHM=RS256
# HRIS_SIGNING_KID=hris-1


# Local Docker only: set to id -u / id -g if signing keys are host-owned.
# AO_DOCKER_UID=1000
# AO_DOCKER_GID=1000
# AO_DOCKER_BRIDGE_DATABASE_URL=postgresql://ao_bridge:password@db:5432/orchestrator
